# --- Telegram (my.telegram.org -> API development tools) ---
TG_API_ID=1234567
TG_API_HASH=your_api_hash_here

# --- Control bot (@BotFather) : panel for approvals and alerts ---
TG_BOT_TOKEN=123456:AAA...

# --- Gemini (خواندن سیگنال از روی عکس) ---
# کلید رایگان: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# اگر سرویس Gemini از شبکه‌ات مستقیم در دسترس نیست، پراکسی را اینجا بگذار
# GEMINI_PROXY=http://127.0.0.1:10809

# --- cTrader Open API (بروکر مستقیم، روی لینوکس هم کار می‌کند) ---
# اپ را در https://connect.spotware.com بساز تا این دو را بگیری
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
# این سه را ابزار tools/ctrader_auth.py برایت پر می‌کند
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=

# --- MetaTrader 5 account (فقط اگر broker: mt5 باشد) ---
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=LiteFinance-MT5-Demo
MT5_PATH=C:\Program Files\LiteFinance MT5 Terminal\terminal64.exe
